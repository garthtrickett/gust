{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scripts/phase23_assurance_envelope.schema.json",
  "title": "Gust Phase 23 report-only semantic change assurance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "source_identity", "loss_taxonomy", "repository_facts", "envelopes"],
  "properties": {
    "schema_version": {"const": "phase23_assurance_envelope_v1"},
    "phase": {"const": "23"},
    "source_identity": {"$ref": "#/$defs/identity"},
    "loss_taxonomy": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string"}},
    "repository_facts": {"$ref": "#/$defs/repositoryFacts"},
    "envelopes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/envelope"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "observed_main_sha", "base_sha", "observed_at_utc"],
      "properties": {
        "repository": {"const": "garthtrickett/gust"},
        "observed_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "role"],
      "properties": {
        "kind": {"enum": ["operator_authority", "inherited_contract", "assumption", "parked_scope", "candidate_evidence", "closure_evidence"]},
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_state", "authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "required_state": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1}
      }
    },
    "repositoryFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset", "workflow_file_count", "pull_request_trigger_count", "push_trigger_count", "workflow_dispatch_trigger_count", "qualification_rule"],
      "properties": {
        "ruleset": {"type": "object"},
        "workflow_file_count": {"type": "integer", "minimum": 1},
        "pull_request_trigger_count": {"type": "integer", "minimum": 1},
        "push_trigger_count": {"type": "integer", "minimum": 1},
        "workflow_dispatch_trigger_count": {"type": "integer", "minimum": 1},
        "qualification_rule": {"const": "exact_full_candidate_head_sha_and_event_pull_request_with_all_review_threads_resolved"}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "issue", "state", "risk_class", "source_identity", "authority_references", "expected_inventory", "observed_loss_states", "candidate_evidence", "closure_evidence", "assumptions", "non_goals", "parked_scope"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "issue": {"type": "integer", "minimum": 1},
        "state": {"enum": ["historical_closed_input", "open_repair_input", "planned_R1_pilot"]},
        "risk_class": {"enum": ["R1", "R2", "R3"]},
        "source_identity": {"$ref": "#/$defs/identity"},
        "authority_references": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/reference"}},
        "expected_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventoryItem"}},
        "observed_loss_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "candidate_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "closure_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "parked_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}

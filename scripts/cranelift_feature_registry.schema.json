{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scripts/cranelift_feature_registry.schema.json",
  "title": "Gust Cranelift feature registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "registry_version",
    "registry_status",
    "current_phase",
    "closed_phase_versions",
    "closure_snapshots",
    "opening_snapshots",
    "residual_snapshots",
    "planning_categories",
    "supported_values",
    "legacy_views",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "scripts/cranelift_feature_registry.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "const": 7
    },
    "registry_status": {
      "const": "phase13_closed_deferred_registry_parity_expansion"
    },
    "current_phase": {
      "const": "phase13"
    },
    "closed_phase_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "phase11",
        "phase12_5_opening",
        "phase12_5",
        "phase13"
      ]
    },
    "closure_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase11",
        "phase13"
      ],
      "properties": {
        "phase11": {
          "$ref": "#/$defs/phase11_closure_snapshot"
        },
        "phase13": {
          "$ref": "#/$defs/phase13_closure_snapshot"
        }
      }
    },
    "opening_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase13"
      ],
      "properties": {
        "phase13": {
          "$ref": "#/$defs/phase13_opening_snapshot"
        }
      }
    },
    "residual_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase13"
      ],
      "properties": {
        "phase13": {
          "$ref": "#/$defs/phase13_residual_snapshot"
        }
      }
    },
    "planning_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "supported_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "origin_phases",
        "feature_families",
        "route_owners",
        "worker_capability_owners",
        "diagnostic_owners"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "origin_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worker_capability_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diagnostic_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "legacy_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase11",
        "phase13",
        "generated_summary"
      ],
      "properties": {
        "phase11": {
          "type": "string",
          "minLength": 1
        },
        "phase13": {
          "type": "string",
          "minLength": 1
        },
        "generated_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "phase11_closure_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_version",
        "immutable_fields",
        "entry_count",
        "classification_counts",
        "deferred_entry_ids",
        "entries",
        "byte_provenance",
        "comparison_policy"
      ],
      "properties": {
        "closure_version": {
          "type": "string",
          "minLength": 1
        },
        "immutable_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "migrated",
            "deferred",
            "excluded"
          ],
          "properties": {
            "migrated": {
              "type": "integer",
              "minimum": 0
            },
            "deferred": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "deferred_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase11_closure_snapshot_entry"
          }
        },
        "byte_provenance": {
          "const": "git_history"
        },
        "comparison_policy": {
          "const": "semantic_fields_only_whitespace_prose_field_order_and_generated_layout_are_ignored"
        }
      }
    },
    "phase11_closure_snapshot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "feature_family",
        "route_owner",
        "source_fixture",
        "canonical_mir_fixture",
        "ci_family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "migrated",
            "deferred",
            "excluded"
          ]
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "route_owner": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture": {
          "type": "string",
          "minLength": 1
        },
        "canonical_mir_fixture": {
          "type": "string",
          "minLength": 1
        },
        "ci_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase13_opening_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening_version",
        "inventory_version",
        "status",
        "predecessor_closure_version",
        "immutable_fields",
        "entries",
        "comparison_policy",
        "behavior_policy",
        "next_patch"
      ],
      "properties": {
        "opening_version": {
          "const": "phase13_opening_inventory_rebased_on_phase12_5_framework"
        },
        "inventory_version": {
          "const": "phase13_opening_inventory_v1"
        },
        "status": {
          "const": "ready_for_patch13_1"
        },
        "predecessor_closure_version": {
          "type": "string",
          "minLength": 1
        },
        "immutable_fields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "id",
              "parent"
            ]
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase13_opening_snapshot_entry"
          }
        },
        "comparison_policy": {
          "const": "semantic_ids_and_parent_relationships_only_generated_totals_and_markdown_are_derived"
        },
        "behavior_policy": {
          "const": "registry_projection_and_guard_rebase_only_no_compiler_route_worker_MIR_request_object_link_package_CLI_or_workflow_change"
        },
        "next_patch": {
          "const": "13.1"
        }
      }
    },
    "phase13_opening_snapshot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "parent": {
          "type": "string",
          "pattern": "^phase11_(entry|category):[A-Za-z0-9_]+$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin_phase",
        "parent",
        "feature_family",
        "ci_family",
        "status",
        "route_owner",
        "worker_capability_owner",
        "diagnostic_owner",
        "source_fixture",
        "canonical_mir_fixture",
        "differential_case_id",
        "deferral_reason",
        "future_destination_phase",
        "closure_version",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_phase": {
                "const": "phase13"
              }
            },
            "required": [
              "origin_phase"
            ]
          },
          "then": {
            "required": [
              "capability_id",
              "capability_decision_owner",
              "capability_decision",
              "capability_reason_code",
              "expected_failure_stage"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "origin_phase": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "pattern": "^phase11_(root|entry|category):[A-Za-z0-9_]+$"
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "ci_family": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "route_owner": {
          "type": "string",
          "minLength": 1
        },
        "worker_capability_owner": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_owner": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "capability_decision_owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "capability_decision": {
          "enum": [
            "supported",
            "deferred",
            "source_or_type_failure"
          ]
        },
        "capability_reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "expected_failure_stage": {
          "enum": [
            "none_supported",
            "before_driver_discovery"
          ]
        },
        "source_fixture": {
          "type": "string",
          "minLength": 1
        },
        "canonical_mir_fixture": {
          "type": "string",
          "minLength": 1
        },
        "differential_case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+:[A-Za-z0-9_]+$"
        },
        "deferral_reason": {
          "type": "string",
          "minLength": 1
        },
        "future_destination_phase": {
          "type": "string",
          "minLength": 1
        },
        "closure_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "phase13_residual_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "source_opening_version",
        "immutable_fields",
        "broad_description_bans",
        "resolution_policy",
        "freeze_policy",
        "rows"
      ],
      "properties": {
        "version": {
          "const": "phase13_deferred_residue_v1"
        },
        "status": {
          "const": "frozen_for_future_phases"
        },
        "source_opening_version": {
          "const": "phase13_opening_inventory_v1"
        },
        "immutable_fields": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "broad_description_bans": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution_policy": {
          "type": "string",
          "minLength": 1
        },
        "freeze_policy": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase13_residual_row"
          }
        }
      }
    },
    "phase13_residual_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feature_family",
        "ci_family",
        "capability_owner",
        "diagnostic_owner",
        "capability",
        "concrete_reason",
        "destination_phase",
        "prerequisite_capability",
        "current_failure_stage",
        "positive_future_fixture",
        "negative_current_fixture",
        "diagnostic_reason_code",
        "source_phase13_entry_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "ci_family": {
          "type": "string",
          "minLength": 1
        },
        "capability_owner": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_owner": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "concrete_reason": {
          "type": "string",
          "minLength": 1
        },
        "destination_phase": {
          "type": "string",
          "pattern": "^phase[0-9]+$"
        },
        "prerequisite_capability": {
          "type": "string",
          "minLength": 1
        },
        "current_failure_stage": {
          "type": "string",
          "minLength": 1
        },
        "positive_future_fixture": {
          "type": "string",
          "minLength": 1
        },
        "negative_current_fixture": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_reason_code": {
          "type": "string",
          "pattern": "^deferred_[A-Za-z0-9_]+$"
        },
        "source_phase13_entry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "phase13_closure_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_version",
        "status",
        "scope",
        "opening_version",
        "residual_version",
        "closure_guard",
        "ci_owner",
        "closure_wording",
        "non_claims",
        "required_contracts",
        "closure_assertions",
        "forbidden_replays",
        "opening_entry_count",
        "disposition_counts",
        "migrated_entry_ids",
        "replaced_entry_ids",
        "excluded_entry_ids",
        "residual_entry_count",
        "migrated_route_owner",
        "default_oracle_owner",
        "explicit_cranelift_fallback_policy",
        "worker_request_boundary",
        "artifact_owner",
        "differential_owner",
        "historical_owner",
        "evidence_replay_policy",
        "comparison_policy"
      ],
      "properties": {
        "closure_version": {
          "const": "phase13_closed_deferred_registry_parity_expansion"
        },
        "status": {
          "const": "closed_declared_inventory_only"
        },
        "scope": {
          "const": "declared_phase13_deferred_parity_expansion_inventory_only"
        },
        "opening_version": {
          "const": "phase13_opening_inventory_v1"
        },
        "residual_version": {
          "const": "phase13_deferred_residue_v1"
        },
        "closure_guard": {
          "const": "guard-cranelift-phase13-close"
        },
        "ci_owner": {
          "const": "PR_Fast_Level1_phase_closure"
        },
        "closure_wording": {
          "type": "string",
          "minLength": 1
        },
        "non_claims": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_contracts": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closure_assertions": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_replays": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "opening_entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "disposition_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "migrated",
            "replaced",
            "excluded"
          ],
          "properties": {
            "migrated": {
              "type": "integer",
              "minimum": 0
            },
            "replaced": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "migrated_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replaced_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "residual_entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "migrated_route_owner": {
          "const": "generic_canonical_mir"
        },
        "default_oracle_owner": {
          "const": "mir_to_c"
        },
        "explicit_cranelift_fallback_policy": {
          "const": "forbidden"
        },
        "worker_request_boundary": {
          "const": "request_data_and_canonical_mir_only"
        },
        "artifact_owner": {
          "const": "phase9g_compiler_transactional_object_link_cleanup_and_publication"
        },
        "differential_owner": {
          "const": "registry_derived_level2_families"
        },
        "historical_owner": {
          "const": "scheduled_or_manual_cranelift_historical_full_level3"
        },
        "evidence_replay_policy": {
          "const": "validate_ownership_and_wiring_without_replaying_level2_or_level3"
        },
        "comparison_policy": {
          "const": "semantic_registry_fields_and_wiring_only_no_raw_hashes_or_matrix_correctness_totals"
        }
      }
    }
  }
}

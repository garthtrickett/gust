{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scripts/cranelift_feature_registry.schema.json",
  "title": "Gust Cranelift feature registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "registry_version",
    "registry_status",
    "current_phase",
    "closed_phase_versions",
    "closure_snapshots",
    "opening_snapshots",
    "planning_categories",
    "supported_values",
    "legacy_views",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "scripts/cranelift_feature_registry.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "const": 2
    },
    "registry_status": {
      "const": "phase12_5_closed_cranelift_verification_framework_consolidation"
    },
    "current_phase": {
      "const": "phase13"
    },
    "closed_phase_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "phase11",
        "phase12_5_opening",
        "phase12_5"
      ]
    },
    "closure_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase11"
      ],
      "properties": {
        "phase11": {
          "$ref": "#/$defs/phase11_closure_snapshot"
        }
      }
    },
    "opening_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase13"
      ],
      "properties": {
        "phase13": {
          "$ref": "#/$defs/phase13_opening_snapshot"
        }
      }
    },
    "planning_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "supported_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "origin_phases",
        "feature_families",
        "route_owners",
        "worker_capability_owners",
        "diagnostic_owners"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "origin_phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worker_capability_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diagnostic_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "legacy_views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase11",
        "phase13",
        "generated_summary"
      ],
      "properties": {
        "phase11": {
          "type": "string",
          "minLength": 1
        },
        "phase13": {
          "type": "string",
          "minLength": 1
        },
        "generated_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "phase11_closure_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_version",
        "immutable_fields",
        "entry_count",
        "classification_counts",
        "deferred_entry_ids",
        "entries",
        "byte_provenance",
        "comparison_policy"
      ],
      "properties": {
        "closure_version": {
          "type": "string",
          "minLength": 1
        },
        "immutable_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "migrated",
            "deferred",
            "excluded"
          ],
          "properties": {
            "migrated": {
              "type": "integer",
              "minimum": 0
            },
            "deferred": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "deferred_entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase11_closure_snapshot_entry"
          }
        },
        "byte_provenance": {
          "const": "git_history"
        },
        "comparison_policy": {
          "const": "semantic_fields_only_whitespace_prose_field_order_and_generated_layout_are_ignored"
        }
      }
    },
    "phase11_closure_snapshot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "feature_family",
        "route_owner",
        "source_fixture",
        "canonical_mir_fixture",
        "ci_family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "migrated",
            "deferred",
            "excluded"
          ]
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "route_owner": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture": {
          "type": "string",
          "minLength": 1
        },
        "canonical_mir_fixture": {
          "type": "string",
          "minLength": 1
        },
        "ci_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase13_opening_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening_version",
        "inventory_version",
        "status",
        "predecessor_closure_version",
        "immutable_fields",
        "entries",
        "comparison_policy",
        "behavior_policy",
        "next_patch"
      ],
      "properties": {
        "opening_version": {
          "const": "phase13_opening_inventory_rebased_on_phase12_5_framework"
        },
        "inventory_version": {
          "const": "phase13_opening_inventory_v1"
        },
        "status": {
          "const": "ready_for_patch13_1"
        },
        "predecessor_closure_version": {
          "type": "string",
          "minLength": 1
        },
        "immutable_fields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "id",
              "parent"
            ]
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase13_opening_snapshot_entry"
          }
        },
        "comparison_policy": {
          "const": "semantic_ids_and_parent_relationships_only_generated_totals_and_markdown_are_derived"
        },
        "behavior_policy": {
          "const": "registry_projection_and_guard_rebase_only_no_compiler_route_worker_MIR_request_object_link_package_CLI_or_workflow_change"
        },
        "next_patch": {
          "const": "13.1"
        }
      }
    },
    "phase13_opening_snapshot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "parent": {
          "type": "string",
          "pattern": "^phase11_(entry|category):[A-Za-z0-9_]+$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin_phase",
        "parent",
        "feature_family",
        "ci_family",
        "status",
        "route_owner",
        "worker_capability_owner",
        "diagnostic_owner",
        "source_fixture",
        "canonical_mir_fixture",
        "differential_case_id",
        "deferral_reason",
        "future_destination_phase",
        "closure_version",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "origin_phase": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "pattern": "^phase11_(root|entry|category):[A-Za-z0-9_]+$"
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "ci_family": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "route_owner": {
          "type": "string",
          "minLength": 1
        },
        "worker_capability_owner": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_owner": {
          "type": "string",
          "minLength": 1
        },
        "source_fixture": {
          "type": "string",
          "minLength": 1
        },
        "canonical_mir_fixture": {
          "type": "string",
          "minLength": 1
        },
        "differential_case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+:[A-Za-z0-9_]+$"
        },
        "deferral_reason": {
          "type": "string",
          "minLength": 1
        },
        "future_destination_phase": {
          "type": "string",
          "minLength": 1
        },
        "closure_version": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}

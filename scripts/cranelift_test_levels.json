    },
    "3": {
      "name": "historical-full",
      "ci_owner": "Cranelift Historical Full scheduled/manual workflow",
      "policy": "full Phase 9-14 history, native/object/link/reproducibility, packaging, platform evidence, and a registry-derived declared-target matrix covering representative Phase 14 values, layouts, memory witnesses, nested aggregates, joins, and loop-carried composition evidence"

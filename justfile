    rg -n -F 'block_0_terminator: JumpFunctionParam' "$fixture" compiler/mir.gst >/dev/null
    rg -n -F 'block_1_terminator: JumpBlockParamAddI32Literal' "$fixture" compiler/mir.gst >/dev/null

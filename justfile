    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Native compiling compiler-owned MIR local-binding/read ingestion seam smoke..."
    fixture="compiler/fixtures/native_backend_local_binding_read_ingestion.mir"
    just guard-cranelift-backend-surface

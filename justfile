    printf '%s\n' '  if (tiny_cranelift_increment_local_i32(4) != 5) {' >> "$shim_c"
    printf '%s\n' '    return 1;' >> "$shim_c"
    printf '%s\n' '  }' >> "$shim_c"
    printf '%s\n' '  if (tiny_cranelift_increment_local_i32(0) != 1) {' >> "$shim_c"
    printf '%s\n' '    return 2;' >> "$shim_c"
    printf '%s\n' '  }' >> "$shim_c"
    printf '%s\n' '  return 6;' >> "$shim_c"
    printf '%s\n' '}' >> "$shim_c"

      echo "Phase 17 opening must not place Phase 17 Level 2 or Level 3 rows in PR Fast or Heavy Guards."
      exit 1
    fi
    historical_phase17_rows="$(
      (rg -n \
          -e 'phase17-family:' \
          -e 'guard-cranelift-phase17-.*(parity|differential|complete-runtime)' \
          -e 'matrix\.phase17' \
          "$historical_workflow" || true) |
        rg -v -F 'just guard-cranelift-phase17-complete-runtime-evidence' || true
    )"
    if [ -n "$historical_phase17_rows" ]; then
      echo "Cranelift Historical Full contains an unowned Phase 17 workflow row."
      printf '%s\n' "$historical_phase17_rows"
      exit 1
    fi
    expected_complete_runtime_rows="$(python3 -c 'import json; r=json.load(open("scripts/cranelift_feature_registry.json")); print(1 if "phase17_composition_authority" in r else 0)')"
    actual_complete_runtime_rows="$(rg -n -F 'just guard-cranelift-phase17-complete-runtime-evidence' "$historical_workflow" | wc -l | tr -d ' ')"
    if [ "$actual_complete_runtime_rows" != "$expected_complete_runtime_rows" ]; then
      echo "Phase 17 complete runtime evidence Level 3 ownership drifted."
      exit 1
    fi
    if rg -n -i -e 'sha-?256' -e 'sha256sum' "$registry" "$review" "$canonical_summary" >/dev/null; then
      echo "Phase 17 opening found a forbidden raw registry or Markdown hash contract."
      exit 1
    fi
    if rg -n -e 'EXPECTED_(FAMILY|MATRIX|TARGET|HELPER|RUNTIME)_COUNT' -e '(family|matrix|target|helper|runtime)_count[[:space:]]*=[[:space:]]*[0-9]+' "$opening_validator" "$family_runner" "$pr_workflow" "$heavy_workflow" "$historical_workflow" >/dev/null; then
      echo "Phase 17 opening found an exact matrix or runtime total treated as correctness."
      exit 1
    fi

    guard_body="$(sed -n '/^guard-cranelift-phase17-opening-contract:/,/^guard-cranelift-contract-fast:/p' justfile)"
    if printf '%s\n' "$guard_body" | rg -n -e '^[[:space:]]+just guard-cranelift-phase16-close([[:space:]]|$)' -e '^[[:space:]]+just guard-cranelift-differential-family([[:space:]]|$)' -e '^[[:space:]]+just guard-cranelift-historical-full([[:space:]]|$)' -e '^[[:space:]]+bash scripts/phase17_.*differential\.sh([[:space:]]|$)' -e '^[[:space:]]+\./gust([[:space:]]|$)' -e '^[[:space:]]+(cargo|cc|gcc|clang|make)([[:space:]]|$)' >/dev/null; then
      echo "Phase 17 opening must consume semantic summaries without replaying native or differential evidence."
      exit 1
    fi

    echo "✅ Phase 17 opening inventory passed: stable runtime-boundary rows, Phase 16 parent and residual traceability, explicit helper categories and out-of-scope ownership, fixture pairs, and planned CI families are registry-owned without behavior or workflow-matrix expansion."


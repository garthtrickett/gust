guard-cranelift-phase9f-call-import-schema-validator:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Checking Phase 9F canonical module, call, and import schema validation..."
    readme_doc="compiler/experiments/cranelift/README.md"
    source_file="compiler/experiments/cranelift/src/main.rs"
    valid_fixture="compiler/fixtures/phase9f_call_import_schema_validation.mir"
    build_dir="build/guards/cranelift_phase9f_call_import_schema_validator"
    rm -rf "$build_dir"
    mkdir -p "$build_dir"

    if [ ! -f "$valid_fixture" ]; then
      echo "Missing Phase 9F canonical schema validation fixture: $valid_fixture"
      exit 1
    fi

    rg -n -F 'const COMPILER_MIR_CANONICAL_MODULE_FORMAT: &str = "gust.compiler_mir_ingestion.v2";' "$source_file" >/dev/null
    rg -n -F 'enum CompilerMirLoweringCallTarget' "$source_file" >/dev/null
    rg -n -F 'enum CompilerMirLoweringCallArgument' "$source_file" >/dev/null
    rg -n -F 'struct CompilerMirLoweringModule' "$source_file" >/dev/null
    rg -n -F 'struct CompilerMirLoweringImportedFunction' "$source_file" >/dev/null
    rg -n -F 'enum CompilerMirLoweringFunctionLinkage' "$source_file" >/dev/null
    rg -n '^fn parse_compiler_mir_input' "$source_file" >/dev/null
    rg -n '^fn parse_compiler_mir_module_field_map' "$source_file" >/dev/null
    rg -n '^fn validate_compiler_mir_module' "$source_file" >/dev/null
    rg -n '^fn validate_canonical_compiler_mir_local_call_graph_acyclic' "$source_file" >/dev/null
    rg -n -F '"gust.compiler_mir_ingestion.v1 remains call/import-free"' "$source_file" >/dev/null
    rg -n '^fn lower_compiler_mir_ingestion_module_to_object' "$source_file" >/dev/null
    rg -n '^fn compiler_mir_ingestion_import_signature' "$source_file" >/dev/null
    rg -n -F 'let declared = compiler_mir_pipeline_wrap(' "$source_file" >/dev/null
    rg -n -F 'module.declare_function(' "$source_file" >/dev/null
    rg -n -F 'Linkage::Import,' "$source_file" >/dev/null
    rg -n -F 'module.declare_func_in_func(*candidate_id, builder.func)' "$source_file" >/dev/null

    schema_body="$(sed -n '/^fn parse_compiler_mir_input/,/^fn validate_canonical_compiler_mir_block_parameter_reference/p' "$source_file")"
    if printf '%s\n' "$schema_body" | rg -n 'ObjectBuilder::new|ObjectModule::new|module\.define_function|object_product\.emit' >/dev/null; then
      echo "Phase 9F Patch 2 schema parsing and validation must not create a Cranelift module or object."
      exit 1
    fi

    cargo_cmd=(cargo run --quiet --manifest-path compiler/experiments/cranelift/Cargo.toml --locked --)
    if ! "${cargo_cmd[@]}" compiler-mir-validate-fixture "$valid_fixture" >"$build_dir/valid.log" 2>&1; then
      echo "Phase 9F canonical schema validation fixture failed:"
      cat "$build_dir/valid.log"
      exit 1
    fi
    rg -n -F 'validated canonical compiler MIR module: phase9f_schema_validation (3 defined, 2 imported)' "$build_dir/valid.log" >/dev/null

    valid_output_dir="$build_dir/valid-v2-object"
    if ! "${cargo_cmd[@]}" compiler-mir-ingestion-object "$valid_fixture" "$valid_output_dir/out.o" >"$build_dir/valid-object.log" 2>&1; then
      echo "Phase 9F direct imported-call module emission failed:"
      cat "$build_dir/valid-object.log"
      exit 1
    fi
    test -s "$valid_output_dir/out.o"

    valid_v1_fixture="$build_dir/valid-v1.mir"
    cat >"$valid_v1_fixture" <<'MIR'
    format: gust.compiler_mir_ingestion.v1
    function: phase9f_valid_v1
    backend_symbol: phase9f_valid_v1
    parameter_count: 0
    return_type: int
    local_count: 0
    entry_block: entry
    block_count: 1
    block_0_label: entry
    block_0_parameter_count: 0
    block_0_statement_count: 0
    block_0_terminator_kind: ReturnI32
    block_0_terminator_value: 0
    metadata_count: 0
    expected_exit: 0
    MIR
    if ! "${cargo_cmd[@]}" compiler-mir-validate-fixture "$valid_v1_fixture" >"$build_dir/valid-v1.log" 2>&1; then
      echo "Phase 9F canonical v1 compatibility validation failed:"
      cat "$build_dir/valid-v1.log"
      exit 1
    fi
    rg -n -F 'validated canonical compiler MIR fixture: phase9f_valid_v1 -> phase9f_valid_v1' "$build_dir/valid-v1.log" >/dev/null

    expect_reject() {
      local label="$1"
      local fixture="$2"
      local expected="$3"
      local output_dir="$build_dir/${label}-output"
      local log="$build_dir/${label}.log"
      rm -rf "$output_dir"
      set +e
      "${cargo_cmd[@]}" compiler-mir-ingestion-object "$fixture" "$output_dir/out.o" >"$log" 2>&1
      local status="$?"
      set -e
      if [ "$status" = "0" ]; then
        echo "Expected Phase 9F schema rejection for $label."
        cat "$log"
        exit 1
      fi
      if ! rg -n -F "$expected" "$log" >/dev/null; then
        echo "Pre-output rejection diagnostic mismatch for $label."
        echo "Expected diagnostic substring: $expected"
        echo "Actual compiler output:"
        cat "$log"
        exit 1
      fi
      echo "✅ Pre-output rejection matched: $label"
      if [ -e "$output_dir" ]; then
        echo "Phase 9F schema rejection for $label created output before validation completed."
        find "$output_dir" -maxdepth 2 -print
        exit 1
      fi
    }

    duplicate_import_name="$build_dir/duplicate-import-name.mir"
    sed 's/import_1_name: host_identity/import_1_name: host_add/' "$valid_fixture" >"$duplicate_import_name"
    expect_reject duplicate-import-name "$duplicate_import_name" 'duplicate canonical compiler MIR imported function name'

    conflicting_link_signature="$build_dir/conflicting-link-signature.mir"
    sed 's/import_1_link_symbol: tiny_phase9f_host_identity/import_1_link_symbol: tiny_phase9f_host_add/' "$valid_fixture" >"$conflicting_link_signature"
    expect_reject conflicting-link-signature "$conflicting_link_signature" 'has conflicting signatures'

    duplicate_function_name="$build_dir/duplicate-function-name.mir"
    sed 's/function_2_function: helper_b/function_2_function: helper_a/' "$valid_fixture" >"$duplicate_function_name"
    expect_reject duplicate-function-name "$duplicate_function_name" 'duplicate canonical compiler MIR local function name'

    duplicate_backend_symbol="$build_dir/duplicate-backend-symbol.mir"
    sed 's/function_2_backend_symbol: tiny_phase9f_helper_b/function_2_backend_symbol: tiny_phase9f_helper_a/' "$valid_fixture" >"$duplicate_backend_symbol"
    expect_reject duplicate-backend-symbol "$duplicate_backend_symbol" 'duplicate canonical compiler MIR emitted backend symbol'

    import_function_collision="$build_dir/import-function-collision.mir"
    sed 's/function_2_function: helper_b/function_2_function: host_identity/' "$valid_fixture" >"$import_function_collision"
    expect_reject import-function-collision "$import_function_collision" 'canonical compiler MIR import/function name collision'

    backend_import_collision="$build_dir/backend-import-collision.mir"
    sed 's/function_2_backend_symbol: tiny_phase9f_helper_b/function_2_backend_symbol: tiny_phase9f_host_identity/' "$valid_fixture" >"$backend_import_collision"
    expect_reject backend-import-collision "$backend_import_collision" 'emitted backend symbol collides with imported link symbol'

    unknown_callee="$build_dir/unknown-callee.mir"
    sed 's/function_2_block_0_statement_0_callee: host_identity/function_2_block_0_statement_0_callee: missing_host/' "$valid_fixture" >"$unknown_callee"
    expect_reject unknown-callee "$unknown_callee" 'unknown canonical compiler MIR imported callee missing_host'

    wrong_argument_count="$build_dir/wrong-argument-count.mir"
    sed -e 's/function_0_block_0_statement_1_argument_count: 2/function_0_block_0_statement_1_argument_count: 1/' \
        -e '/function_0_block_0_statement_1_argument_1_/d' \
        "$valid_fixture" >"$wrong_argument_count"
    expect_reject wrong-argument-count "$wrong_argument_count" 'passes 1 argument(s), but callee declares 2 parameter(s)'

    undeclared_destination="$build_dir/undeclared-destination.mir"
    sed 's/function_2_block_0_statement_0_local: result/function_2_block_0_statement_0_local: missing/' "$valid_fixture" >"$undeclared_destination"
    expect_reject undeclared-destination "$undeclared_destination" 'unknown canonical compiler MIR local missing'

    exported_entry_cycle="$build_dir/exported-entry-cycle.mir"
    sed 's/function_1_block_0_statement_0_callee: helper_b/function_1_block_0_statement_0_callee: phase9f_entry/' "$valid_fixture" >"$exported_entry_cycle"
    expect_reject exported-entry-cycle "$exported_entry_cycle" 'must not contain recursion or mutual recursion'

    cyclic_local_calls="$build_dir/cyclic-local-calls.mir"
    sed -e 's/function_2_block_0_statement_0_callee_kind: ImportedFunction/function_2_block_0_statement_0_callee_kind: LocalFunction/' \
        -e 's/function_2_block_0_statement_0_callee: host_identity/function_2_block_0_statement_0_callee: helper_a/' \
        "$valid_fixture" >"$cyclic_local_calls"
    expect_reject cyclic-local-calls "$cyclic_local_calls" 'must not contain recursion or mutual recursion'

    invalid_linkage="$build_dir/invalid-linkage.mir"
    sed 's/function_2_linkage: module_local/function_2_linkage: imported_host/' "$valid_fixture" >"$invalid_linkage"
    expect_reject invalid-linkage "$invalid_linkage" 'invalid canonical compiler MIR defined function linkage'

    indirect_call="$build_dir/indirect-call.mir"
    sed 's/function_0_block_0_statement_0_callee_kind: LocalFunction/function_0_block_0_statement_0_callee_kind: IndirectFunction/' "$valid_fixture" >"$indirect_call"
    expect_reject indirect-call "$indirect_call" 'unsupported canonical compiler MIR call target kind'

    void_import="$build_dir/void-import.mir"
    sed 's/import_1_return_type: int/import_1_return_type: void/' "$valid_fixture" >"$void_import"
    expect_reject void-import "$void_import" 'uses an unsupported scalar ABI'

    multiple_exported_entries="$build_dir/multiple-exported-entries.mir"
    sed 's/function_1_linkage: module_local/function_1_linkage: exported_entry/' "$valid_fixture" >"$multiple_exported_entries"
    if ! "${cargo_cmd[@]}" compiler-mir-validate-fixture "$multiple_exported_entries" >"$build_dir/multiple-exported-entries-validate.log" 2>&1; then
      echo "Phase 9F v2 must admit one-or-more exported_entry definitions."
      cat "$build_dir/multiple-exported-entries-validate.log"
      exit 1
    fi
    multiple_export_output_dir="$build_dir/multiple-exported-entries-output"
    if ! "${cargo_cmd[@]}" compiler-mir-ingestion-object "$multiple_exported_entries" "$multiple_export_output_dir/out.o" >"$build_dir/multiple-exported-entries-object.log" 2>&1; then
      echo "Phase 9F v2 multiple-export object emission failed."
      cat "$build_dir/multiple-exported-entries-object.log"
      exit 1
    fi
    test -s "$multiple_export_output_dir/out.o"

    v1_call="$build_dir/v1-call.mir"
    cat >"$v1_call" <<'MIR'
    format: gust.compiler_mir_ingestion.v1
    function: invalid_v1_call
    backend_symbol: invalid_v1_call
    parameter_count: 0
    return_type: int
    local_count: 1
    local_0_name: result
    local_0_type: int
    entry_block: entry
    block_count: 1
    block_0_label: entry
    block_0_parameter_count: 0
    block_0_statement_count: 1
    block_0_statement_0_kind: LocalI32SetCall
    block_0_statement_0_local: result
    block_0_statement_0_callee_kind: ImportedFunction
    block_0_statement_0_callee: host_identity
    block_0_statement_0_argument_count: 0
    block_0_terminator_kind: ReturnLocalI32
    block_0_terminator_local: result
    metadata_count: 0
    expected_exit: 0
    MIR
    expect_reject v1-call "$v1_call" 'gust.compiler_mir_ingestion.v1 remains call/import-free'


    echo "✅ Phase 9F v2 schema validation remains strict; local, imported, materialization, merge-arm, joined, and dual-join modules emit, and the current inventory is 33/0."


guard-cranelift-phase9f-module-emitter-local-call-cohort:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Checking Phase 9F canonical module emission and local-call cohort..."
    readme_doc="compiler/experiments/cranelift/README.md"
    source_file="compiler/experiments/cranelift/src/main.rs"
    fixture="compiler/fixtures/phase9f_local_call_module.mir"
    imported_fixture="compiler/fixtures/phase9f_call_import_schema_validation.mir"
    build_dir="build/guards/cranelift_phase9f_module_emitter_local_call_cohort"
    object_file="$build_dir/phase9f_local_call_module.o"
    shim_c="$build_dir/phase9f_local_call_module_main.c"
    binary="$build_dir/phase9f_local_call_module_bin"
    rm -rf "$build_dir"
    mkdir -p "$build_dir"

    just guard-cranelift-phase9f-call-import-schema-validator


    rg -n '^fn lower_compiler_mir_ingestion_module_to_object' "$source_file" >/dev/null
    rg -n '^fn define_compiler_mir_ingestion_module_function' "$source_file" >/dev/null
    rg -n '^fn build_compiler_mir_ingestion_body_with_calls' "$source_file" >/dev/null
    rg -n '^fn build_compiler_mir_block_param_local_call_branch_module' "$source_file" >/dev/null
    rg -n -F 'let function_id = compiler_mir_pipeline_wrap(' "$source_file" >/dev/null
    rg -n -F 'module.declare_function(' "$source_file" >/dev/null
    rg -n -F 'module.declare_func_in_func(*candidate_id, builder.func)' "$source_file" >/dev/null
    rg -n -F 'CompilerMirLoweringCallTarget::LocalFunction(callee)' "$source_file" >/dev/null
    rg -n -F 'CompilerMirLoweringCallTarget::ImportedFunction(callee)' "$source_file" >/dev/null
    rg -n -F 'builder.ins().call(function_ref, &lowered_arguments)' "$source_file" >/dev/null
    rg -n '^fn compiler_mir_ingestion_import_signature' "$source_file" >/dev/null
    rg -n -F 'let declared = compiler_mir_pipeline_wrap(' "$source_file" >/dev/null
    rg -n -F 'Linkage::Import,' "$source_file" >/dev/null

    module_emitter_body="$(sed -n '/^fn lower_compiler_mir_ingestion_module_to_object/,/^fn define_compiler_mir_ingestion_module_function/p' "$source_file")"
    declare_line="$(printf '%s\n' "$module_emitter_body" | rg -n -F 'let function_id = compiler_mir_pipeline_wrap(' | head -n1 | cut -d: -f1)"
    define_line="$(printf '%s\n' "$module_emitter_body" | rg -n -F 'define_compiler_mir_ingestion_module_function(' | tail -n1 | cut -d: -f1)"
    if [ -z "$declare_line" ] || [ -z "$define_line" ] || [ "$declare_line" -ge "$define_line" ]; then
      echo "Phase 9F module emission must predeclare every function before defining any function body."
      exit 1
    fi
    adapter_body="$(sed -n '/^fn emit_compiler_mir_block_param_local_call_branch_ingestion_object/,/^fn build_compiler_mir_block_param_local_call_branch_module/p' "$source_file")"
    printf '%s\n' "$adapter_body" | rg -n -F 'parse_compiler_mir_block_param_local_call_branch_ingestion_fixture(&contents)?;' >/dev/null
    printf '%s\n' "$adapter_body" | rg -n -F 'build_compiler_mir_block_param_local_call_branch_module()' >/dev/null
    printf '%s\n' "$adapter_body" | rg -n -F 'lower_compiler_mir_ingestion_module_to_object(output_path, &module)' >/dev/null
    if printf '%s\n' "$adapter_body" | rg -n 'ObjectBuilder::new|ObjectModule::new|TinyMir(Function|BlockFunction|ParamBlockFunction)|lower_tiny_mir_|define_tiny_mir_' >/dev/null; then
      echo "The migrated local-call compatibility adapter must not own a bespoke object module or TinyMir lowering path."
      exit 1
    fi

    rg -n -F 'format: gust.compiler_mir_ingestion.v2' "$fixture" >/dev/null
    rg -n -F 'module: phase9f_local_call_module' "$fixture" >/dev/null
    rg -n -F 'import_count: 0' "$fixture" >/dev/null
    rg -n -F 'function_count: 2' "$fixture" >/dev/null
    rg -n -F 'function_0_linkage: exported_entry' "$fixture" >/dev/null
    rg -n -F 'function_1_linkage: module_local' "$fixture" >/dev/null
    rg -n -F 'function_0_block_1_statement_0_kind: LocalI32SetCall' "$fixture" >/dev/null
    rg -n -F 'function_0_block_1_statement_0_callee_kind: LocalFunction' "$fixture" >/dev/null
    rg -n -F 'function_0_block_1_statement_0_argument_0_kind: BlockParamI32' "$fixture" >/dev/null

    cargo_cmd=(cargo run --quiet --manifest-path compiler/experiments/cranelift/Cargo.toml --locked --)
    if ! "${cargo_cmd[@]}" compiler-mir-validate-fixture "$fixture" >"$build_dir/validate.log" 2>&1; then
      echo "Phase 9F local-call module validation failed:"
      cat "$build_dir/validate.log"
      exit 1
    fi
    rg -n -F 'validated canonical compiler MIR module: phase9f_local_call_module (2 defined, 0 imported)' "$build_dir/validate.log" >/dev/null

    if ! "${cargo_cmd[@]}" compiler-mir-ingestion-object "$fixture" "$object_file" >"$build_dir/object.log" 2>&1; then
      echo "Phase 9F local-call module object emission failed:"
      cat "$build_dir/object.log"
      exit 1
    fi
    test -s "$object_file"

    echo '#include <stdint.h>' > "$shim_c"
    echo 'extern int32_t tiny_native_backend_compiler_mir_ingested_block_param_local_call_branch(int32_t input);' >> "$shim_c"
    echo 'int main(void) {' >> "$shim_c"
    echo '  if (tiny_native_backend_compiler_mir_ingested_block_param_local_call_branch(5) != 79) return 1;' >> "$shim_c"
    echo '  if (tiny_native_backend_compiler_mir_ingested_block_param_local_call_branch(0) != 79) return 2;' >> "$shim_c"
    echo '  if (tiny_native_backend_compiler_mir_ingested_block_param_local_call_branch(-1) != 83) return 3;' >> "$shim_c"
    echo '  return 0;' >> "$shim_c"
    echo '}' >> "$shim_c"
    just cranelift-phase9g-link-canonical-ingestion-object "$fixture" "$object_file" "$shim_c" "$binary"
    "$binary"

    imported_output_dir="$build_dir/imported-output"
    if ! "${cargo_cmd[@]}" compiler-mir-ingestion-object "$imported_fixture" "$imported_output_dir/out.o" >"$build_dir/imported.log" 2>&1; then
      echo "The current shared module emitter must preserve the Patch 3 local-call milestone while allowing direct imported calls:"
      cat "$build_dir/imported.log"
      exit 1
    fi
    test -s "$imported_output_dir/out.o"

    just guard-cranelift-compiler-mir-block-param-local-call-branch-ingestion-native-smoke


    echo "✅ Phase 9F Patch 3 local-call evidence remains green while every later call/import cohort uses shared emission and production routing is unchanged."


guard-cranelift-phase9f-direct-imported-call-cohort:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Checking Phase 9F imported-function emission and direct imported-call cohort..."
    readme_doc="compiler/experiments/cranelift/README.md"
    source_file="compiler/experiments/cranelift/src/main.rs"
    fixture="compiler/fixtures/phase9f_call_import_schema_validation.mir"
    build_dir="build/guards/cranelift_phase9f_direct_imported_call_cohort"
    object_file="$build_dir/phase9f_direct_imported_call_module.o"
    shim_c="$build_dir/phase9f_direct_imported_call_module_main.c"
    binary="$build_dir/phase9f_direct_imported_call_module_bin"
    rm -rf "$build_dir"
    mkdir -p "$build_dir"

    just guard-cranelift-phase9f-module-emitter-local-call-cohort


    rg -n '^fn compiler_mir_ingestion_import_signature' "$source_file" >/dev/null
    rg -n '^fn lower_compiler_mir_ingestion_module_to_object' "$source_file" >/dev/null
    rg -n '^fn define_compiler_mir_ingestion_module_function' "$source_file" >/dev/null
    rg -n -F 'let mut imported_link_ids: HashMap<&str, FuncId> = HashMap::new();' "$source_file" >/dev/null
    rg -n -F 'let mut imported_function_ids: HashMap<&str, FuncId> = HashMap::new();' "$source_file" >/dev/null
    rg -n -F 'module.declare_function(' "$source_file" >/dev/null
    rg -n -F 'Linkage::Import,' "$source_file" >/dev/null
    rg -n -F 'imported_link_ids.insert(imported.link_symbol, declared);' "$source_file" >/dev/null
    rg -n -F 'imported_function_ids.insert(imported.name, function_id);' "$source_file" >/dev/null
    rg -n -F 'module.declare_func_in_func(*imported_id, builder.func)' "$source_file" >/dev/null
    rg -n -F 'CompilerMirLoweringCallTarget::ImportedFunction(callee)' "$source_file" >/dev/null

    module_emitter_body="$(sed -n '/^fn lower_compiler_mir_ingestion_module_to_object/,/^fn define_compiler_mir_ingestion_module_function/p' "$source_file")"
    import_declare_line="$(printf '%s\n' "$module_emitter_body" | rg -n -F 'Linkage::Import,' | head -n1 | cut -d: -f1)"
    local_declare_line="$(printf '%s\n' "$module_emitter_body" | rg -n -F 'let function_id = compiler_mir_pipeline_wrap(' | head -n1 | cut -d: -f1)"
    define_line="$(printf '%s\n' "$module_emitter_body" | rg -n -F 'define_compiler_mir_ingestion_module_function(' | tail -n1 | cut -d: -f1)"
    if [ -z "$import_declare_line" ] || [ -z "$local_declare_line" ] || [ -z "$define_line" ] || [ "$import_declare_line" -ge "$define_line" ] || [ "$local_declare_line" -ge "$define_line" ]; then
      echo "Phase 9F imported and defined functions must all be declared before any function body is defined."
      exit 1
    fi

    cargo_cmd=(cargo run --quiet --manifest-path compiler/experiments/cranelift/Cargo.toml --locked --)
    if ! "${cargo_cmd[@]}" compiler-mir-validate-fixture "$fixture" >"$build_dir/validate.log" 2>&1; then
      echo "Phase 9F direct imported-call validation failed:"
      cat "$build_dir/validate.log"
      exit 1
    fi
    if ! "${cargo_cmd[@]}" compiler-mir-ingestion-object "$fixture" "$object_file" >"$build_dir/object.log" 2>&1; then
      echo "Phase 9F direct imported-call object emission failed:"
      cat "$build_dir/object.log"
      exit 1
    fi
    test -s "$object_file"

    printf '%s\n' \
      '#include <stdint.h>' \
      'int32_t tiny_phase9f_host_add(int32_t lhs, int32_t rhs) { return lhs + rhs; }' \
      'int32_t tiny_phase9f_host_identity(int32_t value) { return value; }' \
      'extern int32_t tiny_phase9f_entry(int32_t input);' \
      'int main(void) {' \
      '  if (tiny_phase9f_entry(5) != 6) return 1;' \
      '  if (tiny_phase9f_entry(0) != 1) return 2;' \
      '  if (tiny_phase9f_entry(-2) != -1) return 3;' \
      '  return 0;' \
      '}' > "$shim_c"
    just cranelift-phase9g-link-canonical-ingestion-object "$fixture" "$object_file" "$shim_c" "$binary"
    "$binary"


    just guard-cranelift-compiler-mir-block-param-imported-call-branch-ingestion-native-smoke
    just guard-cranelift-compiler-mir-block-param-imported-call-return-ingestion-native-smoke
    just guard-cranelift-compiler-mir-block-param-imported-predicate-update-branch-ingestion-native-smoke

    expected_remaining=""


    echo "✅ Phase 9F Patch 4 direct-import evidence remains green within the fully canonical call/import inventory, and production routing is preserved."


guard-cranelift-phase9f-imported-materialization-predicate-cohort:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Checking Phase 9F imported materialization and predicate cohort..."

    rg -n -F 'ingestion is now the required architecture for new experimental Cranelift' "$readme_doc" >/dev/null
    rg -n -F 'CRANELIFT_EXPERIMENT_PRIMARY_ROUTE: mir_to_c' "$manifest_doc" >/dev/null

guard-mir-to-c-boring-surface:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Checking MIR-to-C boring surface before Cranelift..."
    manifest_doc="compiler/MIR_AST_TO_C_RETIREMENT_MANIFEST.md"
    registry_doc="compiler/MIR_FEATURE_MIGRATION_REGISTRY.md"

guard-cranelift-phase9b-close:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔒 Closing Phase 9B: frozen MIR-to-Cranelift translator seed inventory..."
    manifest_doc="compiler/CRANELIFT_EXPERIMENT_MANIFEST.md"
    just guard-cranelift-backend-surface

import "mir_cross_module_abi.gst" as cross_module;
import "mir_cross_module_abi_mir_to_c.gst" as mir_to_c;
import "mir_native_backend_cross_module_abi_request.gst" as cross_module_request;
func fail(message: str) { os.LogStr(message); os.Exit(1); }
func plan(id: str, scenario: str, exporter: str, importer: str, hidden: int, resource_policy: str, value: int, target: str, ctx: &Arena) cross_module.MirCrossModuleAbiPlan[ctx] { mut p: cross_module.MirCrossModuleAbiPlan[ctx]; p.descriptor_id = std.Clone(ctx,id); p.scenario = std.Clone(ctx,scenario); p.exporter_module = std.Clone(ctx,exporter); p.importer_module = std.Clone(ctx,importer); p.linkage_class = std.Clone(ctx,"same_version_gust_static"); p.symbol_id = std.Clone(ctx,std.Concat("symbol:",id)); p.symbol_authority = std.Clone(ctx,"compiler_semantic_module_and_declaration_identity"); p.export_abi_id = std.Clone(ctx,std.Concat("abi:",id)); p.import_abi_id = std.Clone(ctx,p.export_abi_id); p.export_signature_id = std.Clone(ctx,std.Concat("signature:",id)); p.import_signature_id = std.Clone(ctx,p.export_signature_id); p.export_target = std.Clone(ctx,target); p.import_target = std.Clone(ctx,target); p.export_calling_convention = std.Clone(ctx,"gust_canonical_v1"); p.import_calling_convention = std.Clone(ctx,p.export_calling_convention); p.export_layout_id = std.Clone(ctx,std.Concat("layout:",scenario)); p.import_layout_id = std.Clone(ctx,p.export_layout_id); p.export_placement = std.Clone(ctx,std.Concat("placement:",scenario)); p.import_placement = std.Clone(ctx,p.export_placement); p.export_hidden_result = hidden; p.import_hidden_result = hidden; p.export_resource_policy = std.Clone(ctx,resource_policy); p.import_resource_policy = std.Clone(ctx,resource_policy); p.same_compiler_version = 1; p.foreign_symbol = 0; p.phase9g_artifact_owner = std.Clone(ctx,"phase9g_owns_object_link_temporary_and_atomic_publication"); p.expected_value = value; p.actual_value = value; p.source_location = std.Clone(ctx,"compiler/phase16_cross_module_source.gst:10:5"); return p; }
func main() { mut ctx := os.Arena.New(); defer ctx.Free(); os.SetThreadScratch(ctx); mut target := "target:x86_64-unknown-linux-gnu"; mut triple := "x86_64-unknown-linux-gnu"; mut table := cross_module.mir_cross_module_make_empty_table(target,triple,&ctx); table = cross_module.mir_cross_module_table_with_plan(table,plan("cross:param","aggregate_parameter","module:producer","module:consumer",0,"non_resource_copy",11,target,&ctx),&ctx); table = cross_module.mir_cross_module_table_with_plan(table,plan("cross:result","aggregate_result","module:producer","module:consumer",1,"non_resource_copy",21,target,&ctx),&ctx); table = cross_module.mir_cross_module_table_with_plan(table,plan("cross:resource","resource_aggregate_transfer","module:resource","module:consumer",1,"move_only_exact_transfer",31,target,&ctx),&ctx); table = cross_module.mir_cross_module_table_with_plan(table,plan("cross:multiple","multiple_selected_modules","module:secondary","module:consumer",0,"non_resource_copy",41,target,&ctx),&ctx); mut validation := cross_module.mir_cross_module_abi_table_validate(table,&ctx); if validation.valid == 0 { fail(std.Concat("Phase 16.11 cross-module ABI rejected: ",validation.reason_code)); } mut request := cross_module.mir_serialize_cross_module_abi_for_request(table,&ctx); mut witness := mir_to_c.mir_cross_module_abi_mir_to_c_witness(table,&ctx); if os.WriteFile("/tmp/gust-phase16-cross-module-abi.request",request) == 0 || os.WriteFile("/tmp/gust-phase16-cross-module-abi.mir-to-c.witness",witness) == 0 { fail("Phase 16.11 could not write parity artifacts"); } os.LogStr("SUCCESS: Phase 16.11 cross-module ABI smoke passed"); }

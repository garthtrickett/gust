import "mir_native_backend_abi_request.gst" as base;
import "mir_dynamic_stack.gst" as dynamic_stack;
type MirNativeBackendDynamicStackRequest[ctx] struct { format: str, base_request: base.MirNativeBackendAbiRequest[ctx], dynamic_frame_table: dynamic_stack.MirDynamicFrameTable[ctx] }
func mir_native_backend_dynamic_stack_request_is_valid(request: MirNativeBackendDynamicStackRequest[ctx], ctx: &Arena) dynamic_stack.MirDynamicFrameValidation[ctx] { if std.str_eq(request.format,"gust.native_backend.dynamic_stack_request.v1") == 0 { return dynamic_stack.mir_dynamic_stack_validation(0,"dynamic_stack_request_unknown_format",ctx); } mut validation := base.mir_native_backend_abi_request_is_valid(request.base_request,ctx); if validation.valid == 0 { return dynamic_stack.mir_dynamic_stack_validation(0,validation.reason_code,ctx); } return dynamic_stack.mir_dynamic_stack_table_validate(request.dynamic_frame_table,request.base_request.base_request.base_request.layout_table,ctx); }

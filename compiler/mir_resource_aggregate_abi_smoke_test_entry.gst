import "mir_layout.gst" as layout;
import "mir_resource_aggregate_abi.gst" as resource_aggregate;
import "mir_resource_aggregate_abi_mir_to_c.gst" as mir_to_c;
import "mir_native_backend_aggregate_resource_abi_request.gst" as resource_aggregate_request;
func fail(message: str) { os.LogStr(message); os.Exit(1); }
func plan(id: str, scenario: str, position: str, transport: str, ordinal: int, layout_id: str, target: str, triple: str, ctx: &Arena) resource_aggregate.MirResourceAggregateAbiPlan[ctx] { mut value: resource_aggregate.MirResourceAggregateAbiPlan[ctx]; value.plan_id = std.Clone(ctx,id); value.call_id = std.Clone(ctx,std.Concat("call:",id)); value.scenario = std.Clone(ctx,scenario); value.position = std.Clone(ctx,position); value.transport = std.Clone(ctx,transport); value.function_abi_id = std.Clone(ctx,"abi:resource_aggregate"); value.placement_id = std.Clone(ctx,std.Concat("placement:",id)); value.aggregate_type_id = std.Clone(ctx,"type:phase16:ResourceAggregate"); value.layout_id = std.Clone(ctx,layout_id); value.size_bytes = 16; value.alignment = 8; value.abi_value_id = std.Clone(ctx,std.Concat("abi_value:",id)); value.source_resource_id = std.Clone(ctx,std.Concat("resource:source:",id)); value.source_owner = std.Clone(ctx,std.Concat("owner:source:",id)); value.destination_resource_id = std.Clone(ctx,std.Concat("resource:destination:",id)); value.destination_owner = std.Clone(ctx,std.Concat("owner:destination:",id)); value.resource_transition_id = std.Clone(ctx,std.Concat("transition:",id)); value.destination_cleanup_id = std.Clone(ctx,std.Concat("cleanup:destination:",id)); value.destructor_id = std.Clone(ctx,"destructor:resource_aggregate"); value.actual_destructor_id = std.Clone(ctx,"destructor:resource_aggregate"); value.transfer_point = std.Clone(ctx,std.Concat("transfer:",id)); value.transfer_validated = 1; value.silent_copy = 0; value.old_cleanup_cancelled = 1; value.destination_cleanup_created = 1; value.live_owner_count = 1; value.publication_initialized = 1; value.caller_policy = std.Clone(ctx,"move_only_exact_transfer"); value.callee_policy = std.Clone(ctx,"move_only_exact_transfer"); value.failure_before_transfer = std.Clone(ctx,"source_retains_ownership_and_cleanup"); value.failure_after_transfer = std.Clone(ctx,"destination_owns_cleanup"); value.cleanup_order = std.Clone(ctx,"cancel_source>transfer>create_destination>destination_cleanup>destructor"); value.actual_cleanup_order = std.Clone(ctx,value.cleanup_order); value.destructor_count = 1; value.expected_value = ordinal * 10 + 1; value.actual_value = ordinal * 10 + 1; value.target_id = std.Clone(ctx,target); value.actual_target_id = std.Clone(ctx,target); value.target_triple = std.Clone(ctx,triple); value.actual_target_triple = std.Clone(ctx,triple); value.source_location = std.Clone(ctx,"compiler/phase16_resource_aggregate_source.gst:10:5"); return value; }
func main() { mut ctx := os.Arena.New(); defer ctx.Free(); os.SetThreadScratch(ctx); mut target_id := "target:x86_64-unknown-linux-gnu"; mut triple := "x86_64-unknown-linux-gnu"; mut target := layout.mir_layout_make_target_v2(target_id,triple,"little",8,8,4,8,16,&ctx); mut layouts := layout.mir_layout_make_table(target,&ctx); mut i64_layout := layout.mir_layout_make_scalar_type_layout("type:gust:i64",target_id,"primitive",8,8,64,"signed","any_bit_pattern",&ctx); layouts = layout.mir_layout_table_with_layout(layouts,i64_layout,&ctx); mut aggregate_layout := layout.mir_layout_make_type_layout("type:phase16:ResourceAggregate",target_id,"struct",16,8,16,&ctx); aggregate_layout.bit_width = 128; aggregate_layout.validity_kind = "any_bit_pattern"; aggregate_layout = layout.mir_layout_type_with_field(aggregate_layout,layout.mir_layout_make_field("field:resource:handle","handle","type:gust:i64",i64_layout.layout_id,0,8,8,&ctx),&ctx); aggregate_layout = layout.mir_layout_type_with_field(aggregate_layout,layout.mir_layout_make_field("field:resource:tag","tag","type:gust:i64",i64_layout.layout_id,8,8,8,&ctx),&ctx); layouts = layout.mir_layout_table_with_layout(layouts,aggregate_layout,&ctx); mut table := resource_aggregate.mir_resource_aggregate_make_empty_table(target_id,triple,&ctx); table = resource_aggregate.mir_resource_aggregate_table_with_plan(table,plan("resource_aggregate:param","move_into_call","parameter","by_value_move",1,aggregate_layout.layout_id,target_id,triple,&ctx),&ctx); table = resource_aggregate.mir_resource_aggregate_table_with_plan(table,plan("resource_aggregate:return","aggregate_return_new_owner","result","direct_result_move",2,aggregate_layout.layout_id,target_id,triple,&ctx),&ctx); table = resource_aggregate.mir_resource_aggregate_table_with_plan(table,plan("resource_aggregate:nested","nested_resource_aggregate","result","hidden_result_move",3,aggregate_layout.layout_id,target_id,triple,&ctx),&ctx); table = resource_aggregate.mir_resource_aggregate_table_with_plan(table,plan("resource_aggregate:early","early_return_after_receipt","parameter","indirect_by_value_move",4,aggregate_layout.layout_id,target_id,triple,&ctx),&ctx); table = resource_aggregate.mir_resource_aggregate_table_with_plan(table,plan("resource_aggregate:reassign","reassign_returned_aggregate","result","hidden_result_move",5,aggregate_layout.layout_id,target_id,triple,&ctx),&ctx); mut validation := resource_aggregate.mir_resource_aggregate_abi_table_validate(table,layouts,&ctx); if validation.valid == 0 { fail(std.Concat("Phase 16.10 resource aggregate ABI rejected: ",validation.reason_code)); } mut request := resource_aggregate.mir_serialize_resource_aggregate_abi_for_request(table,layouts,&ctx); mut witness := mir_to_c.mir_resource_aggregate_abi_mir_to_c_witness(table,layouts,&ctx); if os.WriteFile("/tmp/gust-phase16-resource-aggregate-abi.request",request) == 0 || os.WriteFile("/tmp/gust-phase16-resource-aggregate-abi.mir-to-c.witness",witness) == 0 { fail("Phase 16.10 could not write parity artifacts"); } os.LogStr("SUCCESS: Phase 16.10 resource aggregate ABI smoke passed"); }

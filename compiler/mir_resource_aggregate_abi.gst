// Phase 16.10 compiler-owned resource-bearing aggregate call ABI.
import "mir_layout.gst" as layout;

type MirResourceAggregateAbiPlan[ctx] struct {
    plan_id: str, call_id: str, scenario: str, position: str,
    transport: str, function_abi_id: str, placement_id: str,
    aggregate_type_id: str, layout_id: str, size_bytes: int, alignment: int,
    abi_value_id: str, source_resource_id: str, source_owner: str,
    destination_resource_id: str, destination_owner: str,
    resource_transition_id: str, destination_cleanup_id: str,
    destructor_id: str, actual_destructor_id: str,
    transfer_point: str, transfer_validated: int, silent_copy: int,
    old_cleanup_cancelled: int, destination_cleanup_created: int,
    live_owner_count: int, publication_initialized: int,
    caller_policy: str, callee_policy: str,
    failure_before_transfer: str, failure_after_transfer: str,
    cleanup_order: str, actual_cleanup_order: str,
    destructor_count: int, expected_value: int, actual_value: int,
    target_id: str, actual_target_id: str,
    target_triple: str, actual_target_triple: str, source_location: str
}
type MirResourceAggregateAbiTable[ctx] struct {
    format: str, target_id: str, target_triple: str,
    authority: str, ownership_policy: str, failure_policy: str,
    plans: Index[std.Vector[MirResourceAggregateAbiPlan[ctx], ctx], ctx]
}
type MirResourceAggregateAbiValidation[ctx] struct { valid: int, reason_code: str }

func mir_resource_aggregate_empty_plans(ctx: &Arena) Index[std.Vector[MirResourceAggregateAbiPlan[ctx], ctx], ctx] { mut values: std.Vector[MirResourceAggregateAbiPlan[ctx], ctx] := std.VectorNew(ctx); mut index: Index[std.Vector[MirResourceAggregateAbiPlan[ctx], ctx], ctx] := os.ArenaAlloc(ctx); ctx.Set(index, values); return index; }
func mir_resource_aggregate_make_empty_table(target_id: str, target_triple: str, ctx: &Arena) MirResourceAggregateAbiTable[ctx] { mut table: MirResourceAggregateAbiTable[ctx]; table.format = std.Clone(ctx,"gust.compiler_resource_aggregate_abi.v1"); table.target_id = std.Clone(ctx,target_id); table.target_triple = std.Clone(ctx,target_triple); table.authority = std.Clone(ctx,"compiler_owned_aggregate_abi_and_phase15_resource_transfer_plan"); table.ownership_policy = std.Clone(ctx,"validated_transfer_cancels_source_cleanup_creates_destination_cleanup_one_live_owner"); table.failure_policy = std.Clone(ctx,"before_transfer_source_retains_ownership_after_transfer_destination_owns_cleanup"); table.plans = mir_resource_aggregate_empty_plans(ctx); return table; }
func mir_resource_aggregate_table_with_plan(table: MirResourceAggregateAbiTable[ctx], value: MirResourceAggregateAbiPlan[ctx], ctx: &Arena) MirResourceAggregateAbiTable[ctx] { mut updated := table; mut values: std.Vector[MirResourceAggregateAbiPlan[ctx], ctx] := ctx[updated.plans]; values.Push(value); ctx.Set(updated.plans,values); return updated; }
func mir_resource_aggregate_validation(valid: int, reason_code: str, ctx: &Arena) MirResourceAggregateAbiValidation[ctx] { mut result: MirResourceAggregateAbiValidation[ctx]; result.valid = valid; result.reason_code = std.Clone(ctx,reason_code); return result; }
func mir_resource_aggregate_layout_by_id(table: layout.MirLayoutTable[ctx], layout_id: str, ctx: &Arena) layout.MirTypeLayoutQuery[ctx] { mut result: layout.MirTypeLayoutQuery[ctx]; result.found = 0; mut values: std.Vector[layout.MirTypeLayout[ctx], ctx] := ctx[table.layouts]; mut index := 0; while index < len(values) { if std.str_eq(values[index].layout_id,layout_id) == 1 { result.found = 1; result.layout = values[index]; return result; } index = index + 1; } return result; }
func mir_resource_aggregate_scenario_valid(scenario: str, position: str, transport: str) int { if std.str_eq(scenario,"move_into_call") == 1 && std.str_eq(position,"parameter") == 1 && std.str_eq(transport,"by_value_move") == 1 { return 1; } if std.str_eq(scenario,"aggregate_return_new_owner") == 1 && std.str_eq(position,"result") == 1 && std.str_eq(transport,"direct_result_move") == 1 { return 1; } if std.str_eq(scenario,"nested_resource_aggregate") == 1 && std.str_eq(position,"result") == 1 && std.str_eq(transport,"hidden_result_move") == 1 { return 1; } if std.str_eq(scenario,"early_return_after_receipt") == 1 && std.str_eq(position,"parameter") == 1 && std.str_eq(transport,"indirect_by_value_move") == 1 { return 1; } if std.str_eq(scenario,"reassign_returned_aggregate") == 1 && std.str_eq(position,"result") == 1 && std.str_eq(transport,"hidden_result_move") == 1 { return 1; } return 0; }

func mir_resource_aggregate_abi_table_validate(table: MirResourceAggregateAbiTable[ctx], layouts: layout.MirLayoutTable[ctx], ctx: &Arena) MirResourceAggregateAbiValidation[ctx] {
    if std.str_eq(table.format,"gust.compiler_resource_aggregate_abi.v1") == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_unknown_format",ctx); }
    if std.str_eq(table.authority,"compiler_owned_aggregate_abi_and_phase15_resource_transfer_plan") == 0 || std.str_eq(table.ownership_policy,"validated_transfer_cancels_source_cleanup_creates_destination_cleanup_one_live_owner") == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_caller_callee_disagreement",ctx); }
    if layout.mir_layout_table_is_valid(layouts,ctx) == 0 || std.str_eq(table.target_id,layouts.target.target_id) == 0 || std.str_eq(table.target_triple,layouts.target.target_triple) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_target_mismatch",ctx); }
    mut values: std.Vector[MirResourceAggregateAbiPlan[ctx], ctx] := ctx[table.plans]; mut index := 0;
    while index < len(values) {
        mut value := values[index]; if len(value.plan_id) == 0 || len(value.call_id) == 0 || len(value.function_abi_id) == 0 || len(value.placement_id) == 0 || len(value.abi_value_id) == 0 || mir_resource_aggregate_scenario_valid(value.scenario,value.position,value.transport) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_record_invalid",ctx); }
        mut aggregate_layout := mir_resource_aggregate_layout_by_id(layouts,value.layout_id,ctx); if aggregate_layout.found == 0 || std.str_eq(aggregate_layout.layout.type_id,value.aggregate_type_id) == 0 || aggregate_layout.layout.size != value.size_bytes || aggregate_layout.layout.alignment != value.alignment || value.size_bytes != 16 || value.alignment != 8 { return mir_resource_aggregate_validation(0,"resource_aggregate_layout_mismatch",ctx); }
        if value.silent_copy != 0 || std.str_find(value.transport,"move") == 0 - 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_silent_copy",ctx); }
        if len(value.source_resource_id) == 0 || len(value.source_owner) == 0 || len(value.destination_resource_id) == 0 || len(value.destination_owner) == 0 || len(value.resource_transition_id) == 0 || std.str_eq(value.source_resource_id,value.destination_resource_id) == 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_missing_destination_identity",ctx); }
        if value.transfer_validated != 1 || len(value.transfer_point) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_transfer_point_invalid",ctx); }
        if value.live_owner_count != 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_two_live_owners",ctx); }
        if value.old_cleanup_cancelled != 1 || value.destination_cleanup_created != 1 || len(value.destination_cleanup_id) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_stale_source_cleanup",ctx); }
        if len(value.destructor_id) == 0 || std.str_eq(value.destructor_id,value.actual_destructor_id) == 0 || value.destructor_count != 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_destructor_mismatch",ctx); }
        if std.str_eq(value.transport,"hidden_result_move") == 1 && value.publication_initialized != 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_uninitialized_publication",ctx); }
        if std.str_eq(value.caller_policy,"move_only_exact_transfer") == 0 || std.str_eq(value.callee_policy,value.caller_policy) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_caller_callee_disagreement",ctx); }
        if std.str_eq(value.failure_before_transfer,"source_retains_ownership_and_cleanup") == 0 || std.str_eq(value.failure_after_transfer,"destination_owns_cleanup") == 0 || std.str_eq(table.failure_policy,"before_transfer_source_retains_ownership_after_transfer_destination_owns_cleanup") == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_caller_callee_disagreement",ctx); }
        if std.str_eq(value.cleanup_order,"cancel_source>transfer>create_destination>destination_cleanup>destructor") == 0 || std.str_eq(value.cleanup_order,value.actual_cleanup_order) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_stale_source_cleanup",ctx); }
        if value.expected_value != value.actual_value { return mir_resource_aggregate_validation(0,"resource_aggregate_value_mismatch",ctx); }
        if std.str_eq(value.target_id,table.target_id) == 0 || std.str_eq(value.actual_target_id,table.target_id) == 0 || std.str_eq(value.target_triple,table.target_triple) == 0 || std.str_eq(value.actual_target_triple,table.target_triple) == 0 { return mir_resource_aggregate_validation(0,"resource_aggregate_target_mismatch",ctx); }
        mut duplicate := index + 1; while duplicate < len(values) { if std.str_eq(values[duplicate].plan_id,value.plan_id) == 1 || std.str_eq(values[duplicate].destination_resource_id,value.destination_resource_id) == 1 || std.str_eq(values[duplicate].destination_cleanup_id,value.destination_cleanup_id) == 1 { return mir_resource_aggregate_validation(0,"resource_aggregate_duplicate_identity",ctx); } duplicate = duplicate + 1; }
        index = index + 1;
    }
    return mir_resource_aggregate_validation(1,"resource_aggregate_abi_valid",ctx);
}
func mir_resource_aggregate_field(output: str, key: str, value: str, ctx: &Arena) str { mut result := std.Concat(output,key); result = std.Concat(result,"="); result = std.Concat(result,value); result = std.Concat(result,";"); return std.Clone(ctx,result); }
func mir_serialize_resource_aggregate_abi_for_request(table: MirResourceAggregateAbiTable[ctx], layouts: layout.MirLayoutTable[ctx], ctx: &Arena) str {
    mut validation := mir_resource_aggregate_abi_table_validate(table,layouts,ctx); if validation.valid == 0 { mut invalid := "resource_aggregate_format: invalid\nresource_aggregate_reason: "; invalid = std.Concat(invalid,validation.reason_code); invalid = std.Concat(invalid,"\n"); return std.Clone(ctx,invalid); }
    mut values: std.Vector[MirResourceAggregateAbiPlan[ctx], ctx] := ctx[table.plans]; mut output := "resource_aggregate_format: gust.compiler_resource_aggregate_abi.v1\n"; output = std.Concat(output,"resource_aggregate_target_id: "); output = std.Concat(output,table.target_id); output = std.Concat(output,"\nresource_aggregate_target_triple: "); output = std.Concat(output,table.target_triple); output = std.Concat(output,"\nresource_aggregate_plan_count: "); output = std.Concat(output,std.FormatInt(len(values))); output = std.Concat(output,"\n");
    mut index := 0; while index < len(values) { mut v := values[index]; mut row := "resource_aggregate_plan:"; row = mir_resource_aggregate_field(row,"id",v.plan_id,ctx); row = mir_resource_aggregate_field(row,"call",v.call_id,ctx); row = mir_resource_aggregate_field(row,"scenario",v.scenario,ctx); row = mir_resource_aggregate_field(row,"position",v.position,ctx); row = mir_resource_aggregate_field(row,"transport",v.transport,ctx); row = mir_resource_aggregate_field(row,"function_abi",v.function_abi_id,ctx); row = mir_resource_aggregate_field(row,"placement",v.placement_id,ctx); row = mir_resource_aggregate_field(row,"type",v.aggregate_type_id,ctx); row = mir_resource_aggregate_field(row,"layout",v.layout_id,ctx); row = mir_resource_aggregate_field(row,"size",std.FormatInt(v.size_bytes),ctx); row = mir_resource_aggregate_field(row,"alignment",std.FormatInt(v.alignment),ctx); row = mir_resource_aggregate_field(row,"abi_value",v.abi_value_id,ctx); row = mir_resource_aggregate_field(row,"source_resource",v.source_resource_id,ctx); row = mir_resource_aggregate_field(row,"source_owner",v.source_owner,ctx); row = mir_resource_aggregate_field(row,"destination_resource",v.destination_resource_id,ctx); row = mir_resource_aggregate_field(row,"destination_owner",v.destination_owner,ctx); row = mir_resource_aggregate_field(row,"transition",v.resource_transition_id,ctx); row = mir_resource_aggregate_field(row,"destination_cleanup",v.destination_cleanup_id,ctx); row = mir_resource_aggregate_field(row,"destructor",v.destructor_id,ctx); row = mir_resource_aggregate_field(row,"actual_destructor",v.actual_destructor_id,ctx); row = mir_resource_aggregate_field(row,"transfer_point",v.transfer_point,ctx); row = mir_resource_aggregate_field(row,"transfer_validated",std.FormatInt(v.transfer_validated),ctx); row = mir_resource_aggregate_field(row,"silent_copy",std.FormatInt(v.silent_copy),ctx); row = mir_resource_aggregate_field(row,"old_cleanup_cancelled",std.FormatInt(v.old_cleanup_cancelled),ctx); row = mir_resource_aggregate_field(row,"destination_cleanup_created",std.FormatInt(v.destination_cleanup_created),ctx); row = mir_resource_aggregate_field(row,"live_owner_count",std.FormatInt(v.live_owner_count),ctx); row = mir_resource_aggregate_field(row,"publication_initialized",std.FormatInt(v.publication_initialized),ctx); row = mir_resource_aggregate_field(row,"caller_policy",v.caller_policy,ctx); row = mir_resource_aggregate_field(row,"callee_policy",v.callee_policy,ctx); row = mir_resource_aggregate_field(row,"failure_before",v.failure_before_transfer,ctx); row = mir_resource_aggregate_field(row,"failure_after",v.failure_after_transfer,ctx); row = mir_resource_aggregate_field(row,"cleanup_order",v.cleanup_order,ctx); row = mir_resource_aggregate_field(row,"actual_cleanup_order",v.actual_cleanup_order,ctx); row = mir_resource_aggregate_field(row,"destructor_count",std.FormatInt(v.destructor_count),ctx); row = mir_resource_aggregate_field(row,"expected_value",std.FormatInt(v.expected_value),ctx); row = mir_resource_aggregate_field(row,"actual_value",std.FormatInt(v.actual_value),ctx); row = mir_resource_aggregate_field(row,"target",v.target_id,ctx); row = mir_resource_aggregate_field(row,"actual_target",v.actual_target_id,ctx); row = mir_resource_aggregate_field(row,"triple",v.target_triple,ctx); row = mir_resource_aggregate_field(row,"actual_triple",v.actual_target_triple,ctx); row = mir_resource_aggregate_field(row,"source",v.source_location,ctx); output = std.Concat(output,row); output = std.Concat(output,"\n"); index = index + 1; }
    return std.Clone(ctx,output);
}

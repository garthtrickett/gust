import "mir_layout.gst" as layout;
import "mir_function_abi_authority.gst" as abi;
import "mir_aggregate_result_abi.gst" as aggregate_result;
import "mir_aggregate_result_abi_mir_to_c.gst" as mir_to_c;
import "mir_native_backend_aggregate_result_request.gst" as native_request;

func fail(message: str) { os.LogStr(message); os.Exit(1); }

func make_classification(id: str, type_id: str, layout_id: str, position: str, mode: str, size: int, alignment: int, target_id: str, target_triple: str, ctx: &Arena) abi.MirAbiValueClassification[ctx] {
    mut v: abi.MirAbiValueClassification[ctx]; v.classification_id = std.Clone(ctx, id); v.type_id = std.Clone(ctx, type_id); v.layout_id = std.Clone(ctx, layout_id); v.position = std.Clone(ctx, position); v.value_class = "aggregate"; v.register_class = std.Clone(ctx, mode); v.size_bytes = size; v.align_bytes = alignment; v.target_id = std.Clone(ctx, target_id); v.target_triple = std.Clone(ctx, target_triple); return v;
}

func make_result(id: str, function_abi: str, result_id: str, classification: str, mode: str, location: str, layout_id: str, hidden: int, ctx: &Arena) abi.MirAbiResultPlacement[ctx] {
    mut v: abi.MirAbiResultPlacement[ctx]; v.placement_id = std.Clone(ctx, id); v.abi_id = std.Clone(ctx, function_abi); v.result_id = std.Clone(ctx, result_id); v.ordinal = 0; v.classification_id = std.Clone(ctx, classification); v.passing_mode = std.Clone(ctx, mode); v.location = std.Clone(ctx, location); v.layout_id = std.Clone(ctx, layout_id); v.resource_id = ""; v.hidden = hidden; return v;
}

func make_plan(id: str, function_abi: str, placement: str, result_id: str, type_id: str, layout_id: str, abi_value: str, shape: str, mode: str, size: int, alignment: int, owner: str, storage: str, init_point: str, hidden_parameter: str, callee_write: str, caller_extract: str, failure: str, target_id: str, target_triple: str, ctx: &Arena) aggregate_result.MirAggregateResultPlan[ctx] {
    mut v: aggregate_result.MirAggregateResultPlan[ctx]; v.plan_id = std.Clone(ctx, id); v.function_abi_id = std.Clone(ctx, function_abi); v.result_placement_id = std.Clone(ctx, placement); v.result_id = std.Clone(ctx, result_id); v.result_ordinal = 0; v.canonical_type_id = std.Clone(ctx, type_id); v.layout_id = std.Clone(ctx, layout_id); v.abi_value_id = std.Clone(ctx, abi_value); v.shape = std.Clone(ctx, shape); v.result_mode = std.Clone(ctx, mode); v.size_bytes = size; v.align_bytes = alignment; v.storage_owner = std.Clone(ctx, owner); v.storage_id = std.Clone(ctx, storage); v.initialization_point = std.Clone(ctx, init_point); v.hidden_parameter_placement = std.Clone(ctx, hidden_parameter); v.callee_write_obligation = std.Clone(ctx, callee_write); v.caller_extraction = std.Clone(ctx, caller_extract); v.failure_behavior = std.Clone(ctx, failure); v.evaluation_cleanup_order = "return_evaluation_then_phase15_cleanup_then_result_transfer"; v.padding_policy = "initialized_fields_only_padding_not_semantic"; v.publication_initialized = 1; v.resource_disposition = "non_resource"; v.resource_transition_id = ""; v.target_id = std.Clone(ctx, target_id); v.target_triple = std.Clone(ctx, target_triple); return v;
}

func make_write(id: str, plan: str, ordinal: int, offset: int, size: int, alignment: int, value: int, ctx: &Arena) aggregate_result.MirAggregateResultFieldWrite[ctx] {
    mut v: aggregate_result.MirAggregateResultFieldWrite[ctx]; v.write_id = std.Clone(ctx, id); v.plan_id = std.Clone(ctx, plan); v.field_ordinal = ordinal; v.byte_offset = offset; v.byte_size = size; v.required_alignment = alignment; v.initialized = 1; v.field_value = value; return v;
}

func make_operation(id: str, plan: str, kind: str, sequence: int, storage: str, ctx: &Arena) aggregate_result.MirAggregateResultOperation[ctx] {
    mut v: aggregate_result.MirAggregateResultOperation[ctx]; v.operation_id = std.Clone(ctx, id); v.plan_id = std.Clone(ctx, plan); v.operation_kind = std.Clone(ctx, kind); v.sequence = sequence; v.storage_id = std.Clone(ctx, storage); v.terminal_control_flow = 0; return v;
}

func add_common_operations(table: aggregate_result.MirAggregateResultTable[ctx], plan: str, storage: str, hidden: int, ctx: &Arena) aggregate_result.MirAggregateResultTable[ctx] {
    mut updated := table; mut sequence := 0;
    if hidden == 1 { updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":allocate"), plan, "allocate_hidden_storage", sequence, storage, ctx), ctx); sequence = sequence + 1; }
    updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":evaluate"), plan, "evaluate_return_value", sequence, storage, ctx), ctx); sequence = sequence + 1;
    updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":write"), plan, "write_result_field", sequence, storage, ctx), ctx); sequence = sequence + 1;
    updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":cleanup"), plan, "phase15_cleanup", sequence, storage, ctx), ctx); sequence = sequence + 1;
    updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":publish"), plan, "publish_result", sequence, storage, ctx), ctx); sequence = sequence + 1;
    updated = aggregate_result.mir_aggregate_result_table_with_operation(updated, make_operation(std.Concat(plan, ":extract"), plan, "extract_result", sequence, storage, ctx), ctx); return updated;
}

func main() {
    mut ctx := os.Arena.New(); defer ctx.Free(); os.SetThreadScratch(ctx);
    mut target_id := "target:x86_64-unknown-linux-gnu"; mut target_triple := "x86_64-unknown-linux-gnu";
    mut target := layout.mir_layout_make_target_v2(target_id, target_triple, "little", 8, 8, 4, 8, 16, &ctx); mut layouts := layout.mir_layout_make_table(target, &ctx);
    mut i32_layout := layout.mir_layout_make_scalar_type_layout("type:gust:i32", target_id, "primitive", 4, 4, 32, "signed", "any_bit_pattern", &ctx); mut i64_layout := layout.mir_layout_make_scalar_type_layout("type:gust:i64", target_id, "primitive", 8, 8, 64, "signed", "any_bit_pattern", &ctx); layouts = layout.mir_layout_table_with_layout(layouts, i32_layout, &ctx); layouts = layout.mir_layout_table_with_layout(layouts, i64_layout, &ctx);
    mut direct_layout := layout.mir_layout_make_type_layout("type:phase16:ResultDirectI32", target_id, "struct", 4, 4, 4, &ctx); direct_layout.bit_width = 32; direct_layout.validity_kind = "any_bit_pattern"; direct_layout = layout.mir_layout_type_with_field(direct_layout, layout.mir_layout_make_field("field:result-direct:value", "value", "type:gust:i32", i32_layout.layout_id, 0, 4, 4, &ctx), &ctx); layouts = layout.mir_layout_table_with_layout(layouts, direct_layout, &ctx);
    mut split_layout := layout.mir_layout_make_type_layout("type:phase16:ResultPairI32", target_id, "struct", 8, 4, 8, &ctx); split_layout.bit_width = 64; split_layout.validity_kind = "any_bit_pattern"; split_layout = layout.mir_layout_type_with_field(split_layout, layout.mir_layout_make_field("field:result-pair:left", "left", "type:gust:i32", i32_layout.layout_id, 0, 4, 4, &ctx), &ctx); split_layout = layout.mir_layout_type_with_field(split_layout, layout.mir_layout_make_field("field:result-pair:right", "right", "type:gust:i32", i32_layout.layout_id, 4, 4, 4, &ctx), &ctx); layouts = layout.mir_layout_table_with_layout(layouts, split_layout, &ctx);
    mut hidden_layout := layout.mir_layout_make_type_layout("type:phase16:ResultTripleI64", target_id, "struct", 24, 8, 24, &ctx); hidden_layout.bit_width = 192; hidden_layout.validity_kind = "any_bit_pattern"; hidden_layout = layout.mir_layout_type_with_field(hidden_layout, layout.mir_layout_make_field("field:result-triple:first", "first", "type:gust:i64", i64_layout.layout_id, 0, 8, 8, &ctx), &ctx); hidden_layout = layout.mir_layout_type_with_field(hidden_layout, layout.mir_layout_make_field("field:result-triple:second", "second", "type:gust:i64", i64_layout.layout_id, 8, 8, 8, &ctx), &ctx); hidden_layout = layout.mir_layout_type_with_field(hidden_layout, layout.mir_layout_make_field("field:result-triple:third", "third", "type:gust:i64", i64_layout.layout_id, 16, 8, 8, &ctx), &ctx); layouts = layout.mir_layout_table_with_layout(layouts, hidden_layout, &ctx);
    if layout.mir_layout_table_is_valid(layouts, &ctx) == 0 { fail("Phase 16.4 fixture layout table invalid"); }

    mut direct_abi := "function_abi:v1:phase16:return-direct"; mut split_abi := "function_abi:v1:phase16:return-split"; mut hidden_abi := "function_abi:v1:phase16:return-hidden";
    mut direct_class := "abi_classification:v1:phase16:return-direct"; mut split_class := "abi_classification:v1:phase16:return-split"; mut hidden_class := "abi_classification:v1:phase16:return-hidden";
    mut direct_place := "abi_placement:v1:phase16:return-direct"; mut split_place := "abi_placement:v1:phase16:return-split"; mut hidden_place := "abi_placement:v1:phase16:return-hidden";
    mut authority := abi.mir_function_abi_make_empty_table(target_id, target_triple, &ctx);
    authority = abi.mir_function_abi_table_with_classification(authority, make_classification(direct_class, direct_layout.type_id, direct_layout.layout_id, "result", "direct", 4, 4, target_id, target_triple, &ctx), &ctx); authority = abi.mir_function_abi_table_with_classification(authority, make_classification(split_class, split_layout.type_id, split_layout.layout_id, "result", "split", 8, 4, target_id, target_triple, &ctx), &ctx); authority = abi.mir_function_abi_table_with_classification(authority, make_classification(hidden_class, hidden_layout.type_id, hidden_layout.layout_id, "hidden_result", "hidden_pointer", 24, 8, target_id, target_triple, &ctx), &ctx);
    authority = abi.mir_function_abi_table_with_result(authority, make_result(direct_place, direct_abi, "result:direct", direct_class, "direct", "canonical_result:0", direct_layout.layout_id, 0, &ctx), &ctx); authority = abi.mir_function_abi_table_with_result(authority, make_result(split_place, split_abi, "result:split", split_class, "split", "canonical_result:0,canonical_result:1", split_layout.layout_id, 0, &ctx), &ctx); authority = abi.mir_function_abi_table_with_result(authority, make_result(hidden_place, hidden_abi, "result:hidden", hidden_class, "hidden_pointer", "hidden_parameter:0", hidden_layout.layout_id, 1, &ctx), &ctx);

    mut direct_plan := "aggregate_result_plan:direct"; mut split_plan := "aggregate_result_plan:split"; mut hidden_plan := "aggregate_result_plan:hidden"; mut hidden_storage := "aggregate_result_storage:caller:triple";
    mut table := aggregate_result.mir_aggregate_result_make_empty_table(target_id, target_triple, &ctx);
    table = aggregate_result.mir_aggregate_result_table_with_plan(table, make_plan(direct_plan, direct_abi, direct_place, "result:direct", direct_layout.type_id, direct_layout.layout_id, direct_class, "struct_single_i32", "direct", 4, 4, "canonical_result_value", "", "during_return_evaluation", "", "produce_canonical_result", "consume_direct_result", "no_result_on_failure", target_id, target_triple, &ctx), &ctx);
    table = aggregate_result.mir_aggregate_result_table_with_plan(table, make_plan(split_plan, split_abi, split_place, "result:split", split_layout.type_id, split_layout.layout_id, split_class, "struct_pair_i32", "split", 8, 4, "canonical_split_values", "", "during_return_evaluation", "", "produce_split_initialized_fields", "join_split_result", "no_result_on_failure", target_id, target_triple, &ctx), &ctx);
    table = aggregate_result.mir_aggregate_result_table_with_plan(table, make_plan(hidden_plan, hidden_abi, hidden_place, "result:hidden", hidden_layout.type_id, hidden_layout.layout_id, hidden_class, "struct_triple_i64", "hidden_pointer", 24, 8, "caller_compiler_plan", hidden_storage, "before_call", "hidden_parameter:0", "write_all_initialized_fields_before_return", "after_successful_publication", "do_not_publish_uninitialized_storage", target_id, target_triple, &ctx), &ctx);
    table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:direct:0", direct_plan, 0, 0, 4, 4, 23, &ctx), &ctx); table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:split:0", split_plan, 0, 0, 4, 4, 29, &ctx), &ctx); table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:split:1", split_plan, 1, 4, 4, 4, 31, &ctx), &ctx); table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:hidden:0", hidden_plan, 0, 0, 8, 8, 37, &ctx), &ctx); table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:hidden:1", hidden_plan, 1, 8, 8, 8, 41, &ctx), &ctx); table = aggregate_result.mir_aggregate_result_table_with_write(table, make_write("aggregate_result_write:hidden:2", hidden_plan, 2, 16, 8, 8, 43, &ctx), &ctx);
    table = add_common_operations(table, direct_plan, "", 0, &ctx); table = add_common_operations(table, split_plan, "", 0, &ctx); table = add_common_operations(table, hidden_plan, hidden_storage, 1, &ctx);
    mut validation := aggregate_result.mir_aggregate_result_table_validate(table, layouts, authority, &ctx); if validation.valid == 0 { fail(std.Concat("Phase 16.4 aggregate result table rejected: ", validation.reason_code)); }
    mut c_emission := mir_to_c.mir_aggregate_result_to_c_source(table, layouts, authority, &ctx); if c_emission.success == 0 || std.str_find(c_emission.c_source, "allocate_hidden_storage") == 0 - 1 { fail("Phase 16.4 MIR-to-C did not consume hidden result operations"); }
    mut request: native_request.MirNativeBackendAggregateResultRequest[ctx]; request.target_triple = target_triple; request.layout_table = layouts; request.abi_authority = authority; request.aggregate_result_table = table;
    mut serialized := native_request.mir_serialize_native_backend_aggregate_result_request(request, &ctx); mut witness := mir_to_c.mir_aggregate_result_mir_to_c_witness(table, layouts, authority, &ctx);
    if os.WriteFile("/tmp/gust-phase16-aggregate-result.request", serialized) == 0 || os.WriteFile("/tmp/gust-phase16-aggregate-result.mir-to-c.witness", witness) == 0 { fail("Phase 16.4 could not write parity artifacts"); }
    os.LogStr("SUCCESS: Phase 16.4 aggregate result ABI smoke passed");
}

    echo "✅ Step 5.2 Resource destructor call tracking guard passed."

guard_step52_resource_double_close_enforcement:
    echo "🔒 Checking Step 5.2H tracked Resource double-close recognition..."
    double_close_helper_count="$(rg -n 'func env_report_linear_resource_double_close' compiler/typechecker.gst | wc -l)"
    if [ "$double_close_helper_count" != "1" ]; then
      echo "❌ Step 5.2H guard failed: expected exactly one double-close diagnostic helper, found $double_close_helper_count"
      rg -n 'func env_report_linear_resource_double_close' compiler/typechecker.gst || true
      exit 1
    fi
    rg -n 'LinearResourceDoubleClose' compiler/typechecker.gst
    rg -n -F 'env_report_linear_resource_double_close(env, resource_name_step52i, first_arg_span_step52h, ctx)' compiler/typechecker.gst
    just guard-positive compiler/typechecker_resource_double_close_rejected_test_entry.gst step52_resource_double_close_rejected
    echo "✅ Step 5.2H tracked Resource double-close recognition guard passed."

# concat.config - Configuration for c.sh aggregation script

# The file where all aggregated contents will be written
OUTPUT_FILE="a.txt"

# Root configuration files to include if they exist in the project root
ROOT_CONFIG_FILES=(
    "justfile"
    "justfile-reports"
    "justfile-step44"
    "justfile-step45"
    "justfile-step51"
    "justfile-step52"
    "flake.nix"
    "Cargo.toml"
    "GEMINI.md"
    "STEP51_DEFERRED_UNSAFE_SEMANTICS.md"
    "STEP52_RESOURCE_SEMANTICS.md"
    "bridge.sh"
    "c.sh"
    "concat.config"
    "Makefile"
)

# Directories to search recursively for target files
TARGET_DIRS=(
    "src"
    "compiler"
    "compiler/experiments/cranelift"
    "tests"
    "tree-sitter-gust"
    "tools"
    "scripts"
)

# File extensions to include without the leading dot.
#
# Keep "rs" enabled so the isolated Cranelift experiment source is included:
#   compiler/experiments/cranelift/src/main.rs
#
# Keep "lock" enabled so the isolated experiment lockfile is included:
#   compiler/experiments/cranelift/Cargo.lock
FILE_EXTENSIONS=(
    "gst"
    "toml"
    "lock"
    "rs"
    "c"
    "h"
    "js"
    "json"
    "scm"
    "py"
    "sh"
    "md"
)

# Patterns or paths to explicitly prune/exclude.
# Supported: folders, filenames, or wildcard patterns.
EXCLUDE_PATTERNS=(
    # Keep Rust enabled for compiler/experiments/cranelift/src/main.rs,
    # but exclude non-experimental Rust files directly under compiler/.
    "compiler/*.rs"

    # Never aggregate build outputs.
    "target"
    "compiler/experiments/cranelift/target"

    "node_modules"
    "tree-sitter-gust/src/*"
    "tree-sitter-gust/bindings"
    "tree-sitter-gust/build"
    "tree-sitter-gust/src/parser.c"
)

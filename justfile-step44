# Step 4.4 textual guard implementations imported by justfile.
# Makefile keeps compatibility wrappers; focused rg/sed guard bodies live here.

_guard-step44-file-scan label files fail pass:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "{{label}}"
    if rg -n '&ctx\[' {{files}} | rg ' as \*(std\.Vector|std\.HashMap|str)'; then
      echo "{{fail}}"
      exit 1
    else
      echo "{{pass}}"
    fi

_guard-step44-range-scan label file range fail pass:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "{{label}}"
    if sed -n '{{range}}' "{{file}}" | rg '&ctx\[' | rg ' as \*(std\.Vector|std\.HashMap|str)'; then
      echo "{{fail}}"
      exit 1
    else
      echo "{{pass}}"
    fi

